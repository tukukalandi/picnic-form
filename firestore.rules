rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Only the authorized administrator (tukukalandi@gmail.com) can edit or delete applicant details
    function isAdmin() {
      return isSignedIn() 
        && request.auth.token.email == 'tukukalandi@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['slNo', 'applicantName', 'gender', 'age', 'mobileNumber', 'totalPersons', 'submissionTime'])
        && data.applicantName is string 
        && data.applicantName.size() >= 2 
        && data.applicantName.size() <= 150
        && data.gender in ['Male', 'Female', 'Other']
        && (data.age is number || data.age is int)
        && data.age >= 1 && data.age <= 120
        && data.mobileNumber is string
        && data.mobileNumber.matches('^[6-9][0-9]{9}$')
        && (data.totalPersons is number || data.totalPersons is int)
        && data.totalPersons >= 1
        && data.submissionTime is string
        && data.submissionTime.size() <= 100;
    }

    match /registrations/{registrationId} {
      // Allow viewing registered members
      allow read: if true;

      // Postal agents can register their consent
      allow create: if isValidId(registrationId) && isValidRegistration(incoming());

      // ONLY the admin (tukukalandi@gmail.com) can edit registered applicant details
      allow update: if isValidId(registrationId) && isValidRegistration(incoming()) && isAdmin();

      // ONLY the admin (tukukalandi@gmail.com) can delete registrations
      allow delete: if isValidId(registrationId) && isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
